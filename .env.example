# Copy this file to `.env` (repo root for Compose, `backend/.env` for the API) and set
# real values. Never commit `.env`. Values below marked REQUIRED have no safe default.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=iran_tutor
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=iran_tutor

# --- Backend (environment variables are read by the FastAPI process) ---
# In multi-provider mode, add provider endpoints/models/API keys in /admin.
# These legacy variables are optional and used only when no managed route exists.
DATABASE_URL=postgresql+asyncpg://iran_tutor:change_me_strong_password@127.0.0.1:5432/iran_tutor
LLM_BASE_URL=
LLM_API_KEY=
TUTOR_MODEL=
VISION_MODEL_A=
VISION_MODEL_B=
VISION_MODEL_PRIMARY=
LLM_TIMEOUT=120
MAX_CONCURRENCY=3

# Deployment environment. Use `production` on real servers: the app then refuses to start
# while ADMIN_PASSWORD is weak/default (<12 chars or placeholder) or SECRET_KEY is missing/short.
# Accepted names: APP_ENV (preferred) or ENVIRONMENT.
APP_ENV=local

# Local demo mode returns canned answers without calling the provider. Keep false in production.
DEMO_MODE=false

# REQUIRED for real use: admin console login. Do NOT keep the default (123).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_to_a_long_random_value
ADMIN_SESSION_TTL_SECONDS=43200

# Number of reverse proxies in front of the API (0 = connect directly, ignore X-Forwarded-For).
# Set to 1 behind one proxy/load balancer so login and OTP rate limits use the real client IP.
TRUSTED_PROXY_HOPS=0

# Independent signing secret for user sessions and OTP.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace_with_another_long_random_secret

# Encryption key for the admin-managed AI-provider vault.
SECRET_KEY=replace_with_long_random_secret

# Optional SMS provider for OTP login: demo | kavenegar | sms_ir | webhook
SMS_PROVIDER=demo
SMS_API_KEY=
SMS_SENDER=
SMS_TEMPLATE=
SMS_WEBHOOK_URL=

# Optional payment provider: demo | zarinpal
PAYMENT_PROVIDER=demo

# Vector store (Qdrant, see docker-compose.yml)
QDRANT_URL=http://127.0.0.1:6333
EMBEDDING_DIMENSION=1536
